{
  "name": "tt16-commercial",
  "private": true,
  "version": "1.1.0",
  "license": "AGPL-3.0-only",
  "description": "Open-source trading-behavior personality experience built on Cloudflare Workers and D1.",
  "homepage": "https://tt16-commercial-sandbox.samsong-1a3.workers.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wzxsph/TT16.git"
  },
  "bugs": {
    "url": "https://github.com/wzxsph/TT16/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:commercial": "npm run build && wrangler dev --config wrangler.commercial.jsonc --local",
    "build": "tsc -b && vite build",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "db:migrate:local": "wrangler d1 migrations apply tt16-commercial --local --config wrangler.commercial.jsonc",
    "db:migrate:sandbox": "wrangler d1 migrations apply tt16-commercial-sandbox --remote --config wrangler.sandbox.jsonc",
    "assets:personalities": "node scripts/prepare-personality-assets.mjs",
    "assets:personalities:v2": "node scripts/prepare-personality-assets.mjs --v2",
    "preview": "vite preview",
    "test": "vitest run",
    "test:api:commercial": "npm run db:migrate:local && node scripts/verify-commercial-api.mjs",
    "test:api:sandbox": "COMMERCIAL_BASE_URL=https://tt16-commercial-sandbox.samsong-1a3.workers.dev node scripts/verify-commercial-api.mjs",
    "test:watch": "vitest",
    "deploy:demo": "npm run build && wrangler deploy",
    "deploy:sandbox": "npm run build && npm run db:migrate:sandbox && wrangler deploy --config wrangler.sandbox.jsonc",
    "tail:sandbox": "wrangler tail tt16-commercial-sandbox --config wrangler.sandbox.jsonc"
  },
  "dependencies": {
    "lucide-react": "1.24.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260711.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "sharp": "0.34.5",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.10",
    "wrangler": "4.110.0"
  }
}
