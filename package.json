{
  "name": "tt16",
  "private": true,
  "version": "2.0.0",
  "license": "AGPL-3.0-only",
  "description": "Open-source, local-first trading-behavior personality atlas and assessment.",
  "homepage": "https://wzxsph.github.io/TT16/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wzxsph/TT16.git"
  },
  "bugs": {
    "url": "https://github.com/wzxsph/TT16/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "serialize-javascript": "7.1.0"
  },
  "scripts": {
    "dev": "npm run dev -w @tt16/web",
    "build": "npm run build -w @tt16/web",
    "build:pages": "npm run build:pages -w @tt16/web",
    "build:weapp": "npm run build -w @tt16/weapp",
    "preview": "npm run preview -w @tt16/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run packages/core/test",
    "test:content": "npm run build -w @tt16/core && node scripts/check-content.mjs",
    "test:web-build": "node scripts/verify-web-build.mjs dist/web",
    "test:pages-build": "node scripts/verify-web-build.mjs dist/pages /TT16/",
    "test:weapp-build": "node scripts/verify-weapp-build.mjs",
    "test:retired-sandbox": "node scripts/verify-retired-sandbox.mjs",
    "test:e2e": "playwright test",
    "test:links": "node scripts/check-links.mjs",
    "assets:personalities": "node scripts/prepare-personality-assets.mjs --v2",
    "assets:free-kit": "node --experimental-strip-types scripts/generate-free-assets.ts",
    "audit:high": "npm audit --audit-level=high",
    "quality": "npm run typecheck && npm test -- --run && npm run test:content && npm run build && npm run test:web-build && npm run build:pages && npm run test:pages-build && npm run test:e2e && npm run build:weapp && npm run test:weapp-build && npm run test:retired-sandbox && npm run test:links && npm run audit:high && git diff --check"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@tarojs/components": "file:packages/taro-components-mini",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/taro-loader": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/node": "24.3.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "sass": "1.102.0",
    "sharp": "0.35.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "webpack": "5.91.0"
  }
}
