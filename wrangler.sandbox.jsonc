{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tt16-commercial-sandbox",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-12",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tt16-commercial-sandbox",
      "database_id": "12a1b551-b48c-4127-8e8f-546668004ac1",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ENV": "sandbox",
    "APP_ORIGIN": "https://tt16-commercial-sandbox.samsong-1a3.workers.dev",
    "PAYMENT_MODE": "mock"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
